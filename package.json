{
  "author": "Jukka Kurkela",
  "bin": {
    "kurkle-check-package": "./bin/check-package.mjs",
    "kurkle-generate-icons": "./bin/generate-icons.mjs",
    "kurkle-install-hooks": "./bin/install-hooks.mjs"
  },
  "bugs": {
    "url": "https://github.com/kurkle/configs/issues"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24"
  },
  "description": "Shared configs for projects",
  "devDependencies": {
    "semantic-release": "^25.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "README.md",
    "biome.json",
    "bin",
    "templates",
    "tsconfig.base.json"
  ],
  "homepage": "https://github.com/kurkle/configs/",
  "keywords": [
    "biome",
    "config",
    "github-actions",
    "githooks",
    "icons",
    "tsconfig"
  ],
  "license": "MIT",
  "name": "@kurkle/configs",
  "peerDependencies": {
    "@biomejs/biome": "^2.3.10",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "png-to-ico": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/configs.git"
  },
  "scripts": {
    "format": "biome check --write",
    "lint": "biome check",
    "prepare": "git config core.hooksPath .githooks || true",
    "release": "semantic-release",
    "test": "mkdir -p coverage/unit && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/unit/lcov.info"
  },
  "version": "0.0.0-development"
}
